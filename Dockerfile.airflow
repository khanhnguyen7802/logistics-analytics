FROM apache/airflow:3.1.3

# Switch to root to install system and Python dependencies
USER root

# Install system packages if required (optional - add as needed)
RUN apt-get update && apt-get install -y curl && apt-get clean

# Switch back to airflow user
USER airflow

# Copy and install project dependencies from pyproject.toml
COPY --chown=airflow:root pyproject.toml /tmp/project/pyproject.toml
COPY --chown=airflow:root src /tmp/project/src
RUN pip install --no-cache-dir /tmp/project

USER root
RUN rm -rf /tmp/project





